-from ki8_lora import engines, install, peak
+from ki8_lora import engines, install, pack_checkpoint, peak
 from ki8_lora.formats import round_input
 from ki8_lora.formats import unpack
 
@@ -56,6 +56,63 @@ def _one(device, profile):
     return results
 
 
+@torch.inference_mode()
+def _a16_checkpoint(device):
+    """Round-trip a real 1.5.0-rc3 (Peak8 weights, BF16 activations) checkpoint.
+
+    `_one` only installs fresh weights through a profile name. W8A16 checkpoints
+    carry their own manifest (activation_format=bf16, version=1.5.0-rc3), and the
+    optimized W32 decoder has to produce the same bytes as the reference path.
+    """
+    dev = torch.device(device)
+    if dev.type != "cuda" or not torch.cuda.is_available():
+        raise RuntimeError("CUDA is required for the W8A16 checkpoint check.")
+    cases = ((347, 511, 43, 31, 79), (3072, 9216, 128, 256, 64))
+    results = []
+    for out_features, in_features, output_tile, token_tile, tokens in cases:
+        g = torch.Generator().manual_seed(703 + out_features)
+        src = nn.Sequential(nn.Linear(in_features, out_features, bias=True)).bfloat16().eval()
+        with torch.no_grad():
+            src[0].weight.copy_(torch.randn(out_features, in_features, generator=g) * 0.02)
+            src[0].bias.copy_(torch.randn(out_features, generator=g) * 0.01)
+        with tempfile.TemporaryDirectory() as root:
+            packed = Path(root) / "a16"
+            meta = pack_checkpoint(src, packed, tile=128, device="cpu", profile="peak8-a16")
+            if meta.get("version") != "1.5.0-rc3":
+                raise RuntimeError("W8A16 checkpoints must declare 1.5.0-rc3")
+            dst = nn.Sequential(nn.Linear(in_features, out_features, bias=True)).bfloat16().eval()
+            dst.load_state_dict(src.state_dict())
+            install(dst, packed=packed, output_tile=output_tile, token_tile=token_tile)
+            dst.to(dev).eval()
+            layer = dst[0]
+            if (layer.weight_format, layer.activation_format) != ("peak8", "bf16"):
+                raise RuntimeError("A 1.5.0-rc3 checkpoint must install as Peak8 weights + BF16 activations")
+            x = torch.randn(tokens, in_features, generator=g, dtype=torch.bfloat16).to(dev) * 0.05
+            with engines.execution("reference"):
+                reference = dst(x)
+            with engines.execution("auto"):
+                optimized = dst(x)
+            if not torch.equal(reference.view(torch.int16), optimized.view(torch.int16)):
+                delta = (reference.float() - optimized.float()).abs().max().item()
+                raise RuntimeError(f"W8A16 auto/reference mismatch at {out_features}x{in_features}: {delta}")
+        results.append(
+            {
+                "shape": [out_features, in_features],
+                "token_tile": token_tile,
+                "output_tile": output_tile,
